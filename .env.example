# ===== InsTareas — variables de entorno (copia a .env y completa) =====

# Base de datos Neon (Prisma 7, driver adapter pg)
DATABASE_URL="postgresql://usuario:password@ep-xxx.us-east-2.aws.neon.tech/instareas?sslmode=require"

# Secretos de sesión y cifrado (generar: openssl rand -base64 32)
NEXTAUTH_SECRET=""
ENCRYPTION_KEY=""

# API de Canvas (Aula Virtual ESPOL)
CANVAS_BASE_URL="https://aulavirtual.espol.edu.ec"

# Sync manual vía GitHub Actions (token fine-grained con Actions: write)
GITHUB_OWNER="tu-usuario"
GITHUB_REPO="InsTareas"
GH_ACTIONS_TOKEN=""

# Web Push (VAPID) — opcional, habilita notificaciones push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu@correo.com"

# URL pública de la app (necesaria para la suscripción del calendario).
# En Vercel se inyecta automáticamente (NEXT_PUBLIC_VERCEL_URL); defínela solo
# si usas dominio propio, p.ej. https://mi-app.vercel.app
NEXT_PUBLIC_APP_URL=""

# ===== Google Calendar (push automático de tareas) — nivel app, no por usuario =====
# Crea un proyecto en Google Cloud Console → API Calendar → OAuth consent screen
# (modo "testing", scope https://www.googleapis.com/auth/calendar.events) con
# redirect https://TU-APP/api/calendar-oauth/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
