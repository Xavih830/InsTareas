generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

generator worker {
  provider            = "prisma-client"
  output              = "../worker/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Importance {
  BAJA
  MEDIA
  ALTA
}

enum TaskStatus {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
}

enum CalendarProvider {
  google
  microsoft
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String?
  espolUsername  String
  espolPassword  String? // cifrado con AES-256-GCM, nunca en texto plano
  espolSession   String? // cookie de sesión de Canvas (headless OIDC), cifrada
  espolToken     String? // Personal Access Token de Canvas, cifrado
  calendarFeedUrl String? // feed ICS del calendario de Canvas (user_<token>.ics), cifrado
  courseNames    Json? // mapa { course_id: nombre }, persistido de sincronizaciones con token
  lastDigestAt   DateTime? // fecha local del último recordatorio diario enviado (una vez por día)
  requiresReauth Boolean  @default(false)
  createdAt      DateTime @default(now())
  tasks          Task[]
  syncLogs       SyncLog[]
  subscriptions  Subscription[]
  courses        Course[]
  calendarConnections CalendarConnection[]
}

model Task {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  externalId    String // id nativo de Canvas, para deduplicar en cada sync
  title         String
  course        String
  dueDate       DateTime
  description   String?
  sourceUrl     String?
  importance    Importance @default(MEDIA)
  priorityScore Float      @default(0)
  status        TaskStatus @default(PENDIENTE)
  calendarEventId String? // id del evento creado en el calendario externo (Google/Outlook)
  courseId      String? // vínculo al curso de Canvas si se pudo resolver
  courseRef     Course?    @relation(fields: [courseId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([userId, externalId])
  @@index([userId, status, priorityScore])
}

// Curso de Canvas del usuario (para la red de contenido)
model Course {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  externalId String // id nativo de Canvas
  name       String
  code       String?
  term       String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  tasks      Task[]
  modules    Module[]

  @@unique([userId, externalId])
}

// Módulo de un curso de Canvas (estructura mínima, escalable)
model Module {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id])
  externalId String // id nativo del módulo en Canvas
  position   Int
  name       String
  state      String? // locked | unlocked | started | completed
  unlockAt   DateTime?
  prereqIds  Json? // ids de módulos previos requeridos
  createdAt  DateTime @default(now())
  items      ModuleItem[]

  @@unique([courseId, externalId])
}

// Ítem dentro de un módulo (archivo, página, quiz, tarea, URL externa...)
model ModuleItem {
  id         String   @id @default(cuid())
  moduleId   String
  module     Module   @relation(fields: [moduleId], references: [id])
  externalId String // id nativo del ítem en Canvas
  position   Int
  title      String
  type       String // Assignment | File | Page | Quiz | ExternalUrl | ...
  contentId  String? // id del contenido al que apunta
  url        String?
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([moduleId, externalId])
}

model SyncLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  runAt      DateTime @default(now())
  success    Boolean
  tasksFound Int
  scope      String   @default("tasks") // "tasks" | "content"
  error      String?
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// Conexión a un calendario externo (OAuth de nivel app; el usuario solo se loguea)
model CalendarConnection {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  provider     CalendarProvider
  refreshToken String // token OAuth cifrado con AES-256-GCM
  accessToken  String? // token temporal cifrado, refrescado por el worker
  expiresAt    DateTime? // expiración del accessToken
  calendarId   String? // id del calendario destino (null = primario)
  connectedAt  DateTime         @default(now())

  @@unique([userId, provider])
}
